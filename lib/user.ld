/* user.ld — розкладка секцій для user-програм NyxOS (Фаза C). За
 * замовчуванням `ld -Ttext=...` вирівнює КОЖНУ секцію (.text, .rodata,
 * ...) на межу сторінки (4КБ) - для КОРИСНОГО навантаження в кілька
 * сотень байтів це роздуває сирий бінарник (objcopy -O binary заповнює
 * ПРОГАЛИНУ між секціями нулями) до 4096+ байтів - РЕАЛЬНА проблема,
 * знайдена живим тестом (hello.bin вийшов 4360 байтів - понад ліміт
 * process.c FRAME_SIZE=4096). Явний SECTIONS-опис без вирівнювання
 * пакує секції ВПРИТУЛ одна до одної.
 */
ENTRY(_start)

SECTIONS
{
    . = 0x40000000; /* USER_BASE (paging.h) - код кожного процесу в СВОЄМУ адресному просторі */

    .text : { *(.text) }
    .rodata : { *(.rodata*) }
    /* .bss - всередині .data: бінарник сирий (без заголовків), і ядро
     * не знає, скільки обнулених байтів додати за кінцем файлу - тож нулі
     * лежать у самому файлі. Купа (sbrk) починається з наступної
     * сторінки за кінцем файлу. */
    .data : { *(.data*) *(.bss*) *(COMMON) }
}
